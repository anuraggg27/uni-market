{
  "name": "@campus-market/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@campus-market/shared": "1.0.0",
    "@electric-sql/pglite": "^0.3.10",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "file-type": "^21.0.0",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "nodemailer": "^9.0.5",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "postgres": "^3.4.7",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5"
  }
}
