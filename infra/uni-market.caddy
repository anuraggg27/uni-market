uni.rocks {
	encode zstd gzip

	request_body {
		max_size 6MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy 127.0.0.1:3020 {
		lb_try_duration 10s
		lb_try_interval 250ms
	}

	log {
		output file /var/log/caddy/uni-market-access.log {
			mode 0640
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 168h
		}
		format json
	}
}

uni-market.shubhang.dev {
	redir https://uni.rocks{uri} permanent
}
