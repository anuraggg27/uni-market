NODE_ENV=development
APP_ENV=local
DEV_MODE=false
PORT=4000

CLIENT_URL=http://localhost:5173
API_URL=http://localhost:4000
# Leave empty for the local Vite proxy; production injects the public API origin at build time.
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_TURNSTILE_SITE_KEY=

# Neon pooled connection in hosted environments. PGlite is the local fallback.
DATABASE_URL=pglite://.data/marketplace

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-an-independent-32-character-secret

# MSG91 OTP Widget for Indian mobile and student-email OTPs.
# Enable both contact points in the widget and configure a verified email domain/template.
# TOKEN_AUTH is browser-visible; AUTH_KEY must remain server-only.
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
MSG91_AUTH_KEY=
MSG91_OTP_LENGTH=4
MSG91_VERIFY_ACCESS_TOKEN_URL=https://api.msg91.com/api/v5/widget/verifyAccessToken

# SMTP is only for non-OTP transactional messages (support, listing and grievance updates).
SMTP_HOST=fusion.mxrouting.net
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=no-reply@uni.rocks
SMTP_PASSWORD=
SMTP_FROM_NAME=Uni Market
SMTP_FROM_EMAIL=no-reply@uni.rocks

# Encryption and public contact settings. Generate a unique 64-hex-character
# encryption key for every deployment.
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CUSTOMER_CARE_EMAIL=support@uni.rocks
GRIEVANCE_EMAIL=grievance@uni.rocks
PRIVACY_EMAIL=privacy@uni.rocks
LEGAL_POLICY_VERSION=2026-08-27

# Verify these against signed processor contracts before production.
EMAIL_PROVIDER_NAME=Your SMTP provider
EMAIL_PROVIDER_REGION=Contracted processing region
DATABASE_REGION=Contracted database region
OBJECT_STORAGE_REGION=Contracted storage region
LOG_REGION=Contracted log-processing region

# Start with dry-run, review retention_runs, then explicitly switch to enforce.
RETENTION_MODE=dry-run
# Closed grievance content is erased after this period unless a legal hold applies.
GRIEVANCE_RETENTION_DAYS=730

CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

BOOTSTRAP_ADMIN_EMAILS=

MAX_LISTING_IMAGES=8
MAX_IMAGE_SIZE_MB=5
MIN_IMAGE_WIDTH=320
MIN_IMAGE_HEIGHT=240
MAX_IMAGE_DIMENSION=5000
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_IP_HOUR=15
TRUST_PROXY=false
# Optional private operations probe. Generate 32 random bytes as 64 hex characters.
# Leave empty until the external monitor is configured; never expose via VITE_*.
MONITORING_TOKEN=
